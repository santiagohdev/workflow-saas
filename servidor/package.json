{
  "name": "workflow-saas-servidor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "start": "node --max-old-space-size=160 --liftoff-only --experimental-strip-types src/index.ts",
    "semilla": "node --experimental-strip-types src/db/semilla.ts",
    "demo:imagen": "BASE_EMBEBIDA=true node --experimental-strip-types src/db/imagenDemo.ts",
    "test": "DATABASE_URL=postgres://prueba:prueba@localhost:5432/prueba JWT_SECRET=clave-de-prueba-suficientemente-larga node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:panel": "npm --prefix ../panel install --include=dev && npm --prefix ../panel run build",
    "prod": "npm run build:panel && NODE_ENV=production node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
