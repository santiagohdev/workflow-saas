PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Clave para firmar los JWT del panel. En producción, algo largo y aleatorio.
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRA_HORAS=12

# PostgreSQL. En Supabase: Project Settings → Database → Connection string → URI.
# Lleva la contraseña adentro: este archivo es el ejemplo, el .env real no se sube.
DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres

# Conexiones simultáneas por instancia. Supabase corta a 60 en total.
DB_POOL_MAX=8

# Secreto del webhook de Stripe. En local podés inventarlo: el script de
# prueba firma los eventos con este mismo valor.
STRIPE_WEBHOOK_SECRET=whsec_local_de_prueba

# Límites del plan gratuito
LIMITE_TABLEROS_GRATIS=3
LIMITE_MIEMBROS_GRATIS=5

# Habilita la ruta que simula el webhook de Stripe en producción. Permite
# activarse premium sin pagar: solo para un despliegue de demostración,
# jamás en uno con clientes reales. Vacío o ausente = apagada.
DEMO_SIMULAR_PAGOS=
